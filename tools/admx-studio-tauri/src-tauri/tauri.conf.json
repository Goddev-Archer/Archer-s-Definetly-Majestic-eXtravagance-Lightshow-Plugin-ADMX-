{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "admx-studio-tauri",
  "version": "0.1.0",
  "identifier": "com.user.admx-studio-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ADMX Studio – KDE Plasma Lightshow Suite (Rust Core)",
        "width": 1380,
        "height": 880,
        "minWidth": 1050,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
